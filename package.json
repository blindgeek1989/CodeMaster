{
  "name": "codemaster",
  "version": "1.0.0",
  "description": "Accessible coding learning platform for screen reader and keyboard users",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "test": "jest",
    "test:e2e": "playwright test",
    "test:unit": "jest tests/unit",
    "audit": "python audit.py"
  },
  "keywords": ["accessibility", "learning", "coding", "screen-reader"],
  "author": "blindgeek1989",
  "license": "MIT",
  "devDependencies": {
    "electron": "^31.0.0",
    "jest": "^29.7.0",
    "@playwright/test": "^1.45.0",
    "electron-playwright-helpers": "^1.7.1"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": ["**/tests/unit/**/*.test.js"]
  }
}
