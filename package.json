{
  "name": "codemaster",
  "version": "1.5.0",
  "description": "Accessible coding learning platform for screen reader and keyboard users",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "test": "jest",
    "test:e2e": "playwright test",
    "test:unit": "jest tests/unit",
    "audit": "python audit.py",
    "dist": "electron-builder --win",
    "release": "electron-builder --win --publish always"
  },
  "keywords": [
    "accessibility",
    "learning",
    "coding",
    "screen-reader"
  ],
  "author": "blindgeek1989",
  "license": "MIT",
  "dependencies": {
    "electron-updater": "^6.3.9",
    "sql.js": "^1.14.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.45.0",
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3",
    "electron-playwright-helpers": "^1.7.1",
    "jest": "^29.7.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/unit/**/*.test.js"
    ]
  },
  "build": {
    "appId": "com.blindgeek1989.codemaster",
    "productName": "CodeMaster",
    "copyright": "Copyright © 2026 blindgeek1989",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "package.json",
      "!node_modules/.cache",
      "!dist/**/*",
      "!tests/**/*"
    ],
    "win": {
      "target": "nsis",
      "artifactName": "${productName}-Setup-${version}.exe"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "CodeMaster",
      "uninstallDisplayName": "CodeMaster — Accessible Coding Platform"
    },
    "publish": {
      "provider": "github",
      "owner": "blindgeek1989",
      "repo": "CodeMaster"
    }
  }
}
